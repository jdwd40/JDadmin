# --- Universal Admin server configuration (copy to .env; never commit .env) ---

# Runtime
NODE_ENV=development
PORT=4100
# Comma separated allowed browser origins for the admin UI (CSRF/origin checks).
# Dev default if unset: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Admin control-plane database (admins, sessions, audit log). Required.
ADMIN_DATABASE_URL=postgres://jdadmin_test:jdadmin_test_local_only@localhost:5432/jdadmin_dev

# Application databases (optional: app shows as unavailable when unset).
# Use least-privilege credentials; the read/write split is per-app configuration.
COINS_DATABASE_URL=
# Optional schema namespace for the Coins tables (simple identifier; defaults
# to the database search_path). Only needed when Coins tables live in their
# own schema.
COINS_SCHEMA=
DWARF_DATABASE_URL=
# UUID of the disabled, role=admin Dwarf control-plane principal created by
# ops/dwarf/001_jdadmin_principal.sql. Required for any Dwarf access.
DWARF_ADMIN_PRINCIPAL_ID=

# In-memory mock adapter for UI development/smoke checks. Never honoured in
# NODE_ENV=production.
JDADMIN_ENABLE_MOCK=false

# Session cookie
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
COOKIE_NAME=jdadmin_session

# Login rate limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=300000

# Destructive-action guards (price-history reset, user delete, inventory delete).
# Destructive actions require ALLOW_DESTRUCTIVE=true in every environment.
# In NODE_ENV=production they additionally require the exact ack below.
ALLOW_DESTRUCTIVE=false
PRODUCTION_DESTRUCTIVE_ACK=I_UNDERSTAND_DESTRUCTIVE_ACTIONS

# First-admin bootstrap (used only by `npm run create-admin`; not required at runtime).
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

# Dwarf password hashing (argon2 native module). If the argon2 package is not
# installed, Dwarf user create/reset-password capabilities are disabled automatically.
